# Copy to .env. Parsed and validated by @xb/core/env at boot — the process refuses
# to start on a missing or malformed value rather than failing later under load.

NODE_ENV=development
LOG_LEVEL=debug

# ── api ──
API_PORT=4000
API_CORS_ORIGINS=http://localhost:3010,http://localhost:3011

# ── postgres ──
DATABASE_URL=postgres://xb:xb@localhost:5432/xb
DATABASE_POOL_MAX=20

# ── redis ──
REDIS_URL=redis://localhost:6380

# ── rabbitmq ──
AMQP_URL=amqp://xb:xb@localhost:5672
AMQP_PREFETCH=16

# ── minio ──
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=xbminio
S3_SECRET_KEY=xbminio123
S3_BUCKET_PACKAGES=xb-packages
S3_BUCKET_DOCUMENTS=xb-documents

# ── jwt ──
# Generate real values: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-000000000000
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-00000000000
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
JWT_ISSUER=xb-platform

# ── telemetry ──
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=xb-api

# ── providers ──
# Empty provider credentials select the stub adapter automatically.
PAYMENT_PROVIDERS=stub
SMS_PROVIDERS=stub
FX_PROVIDERS=stub
STORE_PROVIDERS=stub
CARRIER_PROVIDERS=stub

# ZARINPAL_MERCHANT_ID=
# IDPAY_API_KEY=
# KAVENEGAR_API_KEY=
# SMSIR_API_KEY=
# ANTHROPIC_API_KEY=
