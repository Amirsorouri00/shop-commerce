{"nodes": [{"id": "platform_readme_sandbox", "label": "Sandbox: Scenario Adapters Behind the Real Ports", "file_type": "rationale", "source_file": "platform/README.md", "source_location": "The sandbox", "rationale": "Nothing gated is live, so the sandbox is how the product is actually demonstrated. It is deliberately not a mock layer beside the real one: sandbox adapters implement the same ports and an X-Sandbox-Session request traverses the same controllers, guards, validation and state machine as production traffic \u2014 that is what makes a sandbox run evidence rather than theatre.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "platform_readme_virtual_clock", "label": "Sandbox Virtual Clock + Seeded Determinism", "file_type": "concept", "source_file": "platform/README.md", "source_location": "The sandbox", "rationale": "A five-day delivery is walked through in a meeting by pressing +24 hours: nothing sleeps, past shipment legs become visible, and seeded sessions replay identically every time.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "platform_readme_append_only_ledger", "label": "Database-Enforced Append-Only Ledger", "file_type": "rationale", "source_file": "platform/README.md", "source_location": "The five rules", "rationale": "The Money rule, the transition-table rule and ledger balance are enforced in Postgres via constraints and triggers, not only in application code \u2014 an UPDATE against ledger_entry is rejected by the database itself.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "platform_readme_five_rules", "label": "The Five Rules That Shape Everything", "file_type": "document", "source_file": "platform/README.md", "source_location": "The five rules", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "platform_readme_resolution_pipeline", "label": "ResolutionPipeline / Resolution Ladder", "file_type": "concept", "source_file": "platform/README.md", "source_location": "What is deliberately not built", "rationale": "The ladder is built and tested but no real strategy is registered, because that needs marketplace credentials. Adding the SP-API strategy is one entry in an array in composition/adapters.ts \u2014 the seam is the deliverable.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "platform_readme_lifecycle_script", "label": "scripts/lifecycle.sh End-to-End Lifecycle Driver", "file_type": "code", "source_file": "platform/README.md", "source_location": "Quick start", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "platform_readme_smoke_script", "label": "scripts/smoke.sh API-Level Smoke Checks", "file_type": "code", "source_file": "platform/README.md", "source_location": "Quick start / Testing", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "platform_readme_deliberate_gaps", "label": "Deliberately Unbuilt Seams (real adapters, merchant panel, WS, recon)", "file_type": "document", "source_file": "platform/README.md", "source_location": "What is deliberately not built", "rationale": "Each unbuilt item has a designed seam and no implementation so it can be added without reworking what exists; password hashing is SHA-256 only to match the dev seed and must move to argon2id before production.", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "platform_readme_sandbox", "target": "technical_blueprint_v1_ports_and_adapters", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "platform/README.md", "source_location": "The sandbox", "weight": 1.0}, {"source": "platform_readme_virtual_clock", "target": "platform_readme_sandbox", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "platform/README.md", "sour