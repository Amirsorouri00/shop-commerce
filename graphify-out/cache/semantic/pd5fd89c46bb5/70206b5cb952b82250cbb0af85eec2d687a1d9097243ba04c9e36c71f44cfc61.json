ces", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "feasibility-revalidation-v0.2.md", "source_location": "\u00a7D3", "weight": 1.0}, {"source": "feasibility_revalidation_v0_2_sequencing_roadmap", "target": "feasibility_revalidation_v0_2_agentic_commerce_protocol", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "feasibility-revalidation-v0.2.md", "source_location": "\u00a7D3 phase 5", "weight": 1.0}, {"source": "feasibility_revalidation_v0_2_agentic_commerce_protocol", "target": "feasibility_revalidation_v0_2_universal_commerce_protocol", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "feasibility-revalidation-v0.2.md", "source_location": "\u00a7A1", "weight": 1.0}, {"source": "feasibility_revalidation_v0_2_three_exogenous_gates", "target": "technical_blueprint_v1_compliance_gate", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "feasibility-revalidation-v0.2.md", "source_location": "\u00a7A2, \u00a7D7", "weight": 1.0}, {"source": "feasibility_revalidation_v0_2_exception_classifier", "target": "feasibility_revalidation_v0_2_landed_cost_predictor", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.65, "source_file": "feasibility-revalidation-v0.2.md", "source_location": "both are margin-protection models operating on the same order data at different stages", "weight": 1.0}], "hyperedges": []}